services:
  cloudflare-ddns:
    restart: always
    container_name: Cloudflare-DDNS
    image: oznu/cloudflare-ddns:latest
    environment:
      - API_KEY=${API_KEY}
      - ZONE=${DNS_ZONE}
      # - SUBDOMAIN=monitor
      - PROXIED=true
    networks:
      - web
networks:
  web:
    external: true